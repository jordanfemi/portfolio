# ─── Security headers for all pages ───────────────────────────────────────────
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-XSS-Protection: 1; mode=block
  # Content-Security-Policy is set in netlify.toml, which overrides this file.
  # Do not add one here: two CSPs drift apart and only the toml one takes effect.

# ─── HTML pages: short cache so updates show quickly ───────────────────────────
/*.html
  Cache-Control: public, max-age=300, must-revalidate

# ─── CSS/JS: cache shared stylesheet and scripts ───────────────────────────────
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable

# ─── Static assets: aggressive 1-year cache (immutable filenames) ──────────────
/assets/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/assets/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/assets/*.png
  Cache-Control: public, max-age=31536000, immutable
/assets/*.gif
  Cache-Control: public, max-age=31536000, immutable
/assets/*.webp
  Cache-Control: public, max-age=31536000, immutable
/assets/*.svg
  Cache-Control: public, max-age=31536000, immutable
/assets/videos/*.mp4
  Cache-Control: public, max-age=31536000, immutable
/assets/thumbs/*.jpg
  Cache-Control: public, max-age=31536000, immutable

# ─── Fonts: 1-year cache ───────────────────────────────────────────────────────
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable
